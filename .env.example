# 用法：cp .env.example .env，然后填好下面每一项（等号后面填你自己的值）。

# MySQL 的 root 账号密码，随便设一个强密码（字母+数字，别加特殊符号）
MYSQL_ROOT_PASSWORD=
# 应用连接数据库用的密码，再设一个强密码（和上面那个不要一样）
MYSQL_PASSWORD=
# Redis 密码，设一个强密码，不能留空
REDIS_PASSWORD=
# 登录令牌加密密钥，运行 openssl rand -hex 32 生成一串贴进来
JWT_SECRET=

# 网关绑定地址，不填默认 127.0.0.1（只有服务器本机能访问，需配反向代理才能对外）。
# 想在内网直接用 IP:9080 / IP:9081 访问就填 0.0.0.0。
# 注意：填 0.0.0.0 是明文 HTTP 暴露，同网段可抓到登录密码，只在可信内网这么用。
GATEWAY_BIND=
